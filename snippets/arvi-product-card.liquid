{%- doc -%}
  @param {string} title
  @param {string} [tag]
  @param {string} [meta]
  @param {string} [price]
  @param {string} [url]
  @param {image} [image]
{%- enddoc -%}

<article class="arvi-product-card">
  <a href="{{ url | default: '#' }}" class="arvi-product-card__link">
    <div class="arvi-product-card__media">
      {% if image != blank %}
        {{ image | image_url: width: 400 | image_tag: loading: 'lazy', alt: title }}
      {% else %}
        <svg width="48" height="120" viewBox="0 0 48 120" aria-hidden="true" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 4c-4 8-8 16-8 28v60h16V32c0-12-4-20-8-28Z" stroke="#999" stroke-width="1.5"/>
          <rect x="14" y="88" width="20" height="8" rx="1" fill="#999" opacity="0.5"/>
        </svg>
      {% endif %}
    </div>
    {% if tag != blank %}
      <p class="arvi-product-card__tag">{{ tag }}</p>
    {% endif %}
    <h3 class="arvi-product-card__name">{{ title }}</h3>
    {% if meta != blank %}
      <p class="arvi-product-card__meta">{{ meta }}</p>
    {% endif %}
    {% if price != blank %}
      <p class="arvi-product-card__price">{{ price }}</p>
    {% endif %}
  </a>
  <a class="arvi-btn arvi-product-card__btn" href="{{ url | default: '#' }}">Add to basket</a>
</article>
