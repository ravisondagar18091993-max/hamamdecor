<section
  id="hamam-banner-{{ section.id }}"
  class="hamam-section hamam-banner"
  data-section-id="{{ section.id }}"
  style="--hamam-banner-height: {{ section.settings.banner_height }}vh;"
>
  <div class="hamam-banner__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: loading: 'lazy', widths: '800,1200,1600,2000,2400', sizes: '100vw', alt: section.settings.heading
      }}
    {% else %}
      <div class="hamam-banner__placeholder" aria-hidden="true"></div>
    {% endif %}
  </div>
  <div class="hamam-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  <div class="hamam-banner__content hamam-banner__content--{{ section.settings.text_alignment }}">
    {% if section.settings.heading != blank %}
      <h2 class="hamam-banner__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="hamam-banner__text">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a class="hamam-btn hamam-btn--outline-light" href="{{ section.settings.button_link | default: '#' }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
  {% if section.settings.show_play_overlay %}
    <a
      class="hamam-banner__play"
      href="{{ section.settings.video_link | default: '#' }}"
      {% if section.settings.video_link != blank %}
        target="_blank"
        rel="noopener noreferrer"
      {% endif %}
    >
      <span class="hamam-video-stack__play-ring"></span>
      <span class="hamam-video-stack__play-label">{{ section.settings.play_label }}</span>
    </a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hamam — Full-width banner",
  "tag": "section",
  "class": "hamam-media-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height (vh)",
      "min": 40,
      "max": 95,
      "step": 5,
      "default": 75
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 70,
      "step": 5,
      "default": 25
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sculptural silhouettes"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_play_overlay",
      "label": "Show video play overlay",
      "default": false
    },
    {
      "type": "url",
      "id": "video_link",
      "label": "Video link (play button)"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play label",
      "default": "Video"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Hamam — Full-width banner"
    }
  ]
}
{% endschema %}
