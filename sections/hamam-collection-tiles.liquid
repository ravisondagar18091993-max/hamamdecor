<section class="hamam-collections" id="hamam-collections-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="hamam-container--wide">
    <header class="hamam-row-head hamam-row-head--collections">
      <h2 class="hamam-display">{{ section.settings.heading }}</h2>
      <div class="hamam-row-head__controls">
        {% if section.settings.view_all_label != blank %}
          <a class="hamam-text-link" href="{{ section.settings.view_all_link | default: '/collections' }}">
            {{ section.settings.view_all_label }}
          </a>
        {% endif %}
        <div class="hamam-carousel-arrows" data-hamam-collection-arrows>
          <button
            type="button"
            class="hamam-carousel-arrows__btn"
            data-hamam-collection-prev
            aria-label="Previous collections"
          >
            <span class="hamam-carousel-arrows__icon" aria-hidden="true">‹</span>
          </button>
          <button
            type="button"
            class="hamam-carousel-arrows__btn"
            data-hamam-collection-next
            aria-label="Next collections"
          >
            <span class="hamam-carousel-arrows__icon" aria-hidden="true">›</span>
          </button>
        </div>
      </div>
    </header>

    <div
      class="hamam-collection-slider hamam-slick"
      data-hamam-slick="collections"
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
    >
      {% for block in section.blocks %}
        {% assign fb = 'collection-' | append: forloop.index %}
        <div class="hamam-collection-tile" {{ block.shopify_attributes }}>
          <a class="hamam-collection-tile__link" href="{{ block.settings.link | default: '/collections/all' }}">
            <div class="hamam-collection-tile__media">
              {% render 'hamam-img',
                image: block.settings.image,
                fallback: fb,
                alt: block.settings.title,
                widths: '300,500,800',
                sizes: '(min-width: 1100px) 20vw, 40vw'
              %}
              <span class="hamam-collection-tile__title">{{ block.settings.title }}</span>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hamam — Collection tiles",
  "tag": "section",
  "class": "hamam-collection-tiles-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover our collections"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-advance slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay interval (ms)",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "default": 4500
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Consoles"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hamam — Collection tiles",
      "blocks": [
        { "type": "collection", "settings": { "title": "Consoles" } },
        { "type": "collection", "settings": { "title": "Tables" } },
        { "type": "collection", "settings": { "title": "Pedestals" } },
        { "type": "collection", "settings": { "title": "Objects" } },
        { "type": "collection", "settings": { "title": "New in" } }
      ]
    }
  ]
}
{% endschema %}
