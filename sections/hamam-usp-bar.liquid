<section class="hamam-usp" id="hamam-usp-{{ section.id }}" data-section-id="{{ section.id }}">
  <div
    class="hamam-usp__marquee"
    style="--hamam-usp-duration: {{ section.settings.marquee_speed }}s;"
  >
    <div class="hamam-usp__track">
      {% for copy in (1..2) %}
        <div class="hamam-usp__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
          {% for block in section.blocks %}
            <div class="hamam-usp__item" {{ block.shopify_attributes }}>
              {% if block.settings.icon_image != blank %}
                {{
                  block.settings.icon_image
                  | image_url: width: 48
                  | image_tag: loading: 'lazy', class: 'hamam-usp__icon-img', alt: ''
                }}
              {% elsif block.settings.icon != blank and block.settings.icon != '◇' %}
                <span class="hamam-usp__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {% else %}
                <span class="hamam-usp__icon-svg" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 11 11" fill="none">
                    <path d="M5.5 1 10 5.5 5.5 10 1 5.5 5.5 1Z" stroke="currentColor" stroke-width="1.15" stroke-linejoin="round"/>
                  </svg>
                </span>
              {% endif %}
              <span class="hamam-usp__label">{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hamam — USP bar",
  "tag": "section",
  "class": "hamam-usp-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed (seconds per loop)",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji, optional)",
          "info": "Leave empty or ◇ for the default diamond icon"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (optional)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free UK delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hamam — USP bar",
      "blocks": [
        { "type": "usp", "settings": { "label": "Fast UK delivery" } },
        { "type": "usp", "settings": { "label": "Secure payments" } },
        { "type": "usp", "settings": { "label": "White-glove delivery" } },
        { "type": "usp", "settings": { "label": "Expert support" } }
      ]
    }
  ]
}
{% endschema %}
