<section class="arvi-section arvi-contact" id="arvi-contact-{{ section.id }}">
  <div class="arvi-wrap">
    <h2 class="arvi-contact__title">{{ section.settings.heading }}</h2>
    <div class="arvi-contact__grid">
      {% for block in section.blocks %}
        <div class="arvi-contact__col" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <h3 class="arvi-contact__col-title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="arvi-contact__col-body">{{ block.settings.text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% if section.settings.show_social %}
      <div class="arvi-contact__social">
        {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a>
        {% endif %}
        {% if section.settings.social_facebook != blank %}
          <a href="{{ section.settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "ARVI — Contact footer",
  "tag": "section",
  "class": "arvi-contact-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Contact" },
        { "type": "richtext", "id": "text", "label": "Content", "default": "<p>hello@arvi.ch</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARVI — Contact footer",
      "blocks": [
        { "type": "column", "settings": { "title": "Contact", "text": "<p>Wine advisor<br>+41 44 000 00 00</p>" } },
        { "type": "column", "settings": { "title": "Visit", "text": "<p>Showrooms in Zurich, Lugano & Milano</p>" } },
        { "type": "column", "settings": { "title": "Find us", "text": "<p>Shops & opening hours on arvi.ch</p>" } },
        { "type": "column", "settings": { "title": "Information", "text": "<p>Delivery, wine vault & private clients</p>" } }
      ]
    }
  ]
}
{% endschema %}
