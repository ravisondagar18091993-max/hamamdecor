<section class="arvi-section arvi-reviews" id="arvi-reviews-{{ section.id }}">
  <div class="arvi-wrap">
    <header class="arvi-reviews__head">
      <h2 class="arvi-reviews__title">{{ section.settings.heading }}</h2>
      <div class="arvi-reviews__illustration" aria-hidden="true">
        <svg width="120" height="140" viewBox="0 0 120 140" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="60" cy="42" r="22" stroke="currentColor" stroke-width="1.25"/>
          <path d="M35 115c0-28 11-48 25-48s25 20 25 48" stroke="currentColor" stroke-width="1.25"/>
          <path d="M48 75h24" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
      </div>
    </header>
    <div class="arvi-reviews__track">
      {% for block in section.blocks %}
        <blockquote
          class="arvi-review-card{% if block.settings.featured %} arvi-review-card--featured{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.featured %}
            <p class="arvi-review-card__stars" aria-hidden="true">★★★★★</p>
          {% endif %}
          <p class="arvi-review-card__text">{{ block.settings.quote }}</p>
          {% if block.settings.author != blank %}
            <footer class="arvi-review-card__author">— {{ block.settings.author }}</footer>
          {% endif %}
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>
{% render 'arvi-peaks' %}

{% schema %}
{
  "name": "ARVI — Reviews",
  "tag": "section",
  "class": "arvi-reviews-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers are saying…" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "checkbox", "id": "featured", "label": "Dark featured card", "default": false },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Exceptional service and an unrivalled selection of fine wines." },
        { "type": "text", "id": "author", "label": "Author", "default": "Private client, Zurich" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARVI — Reviews",
      "blocks": [
        { "type": "review", "settings": { "featured": true, "quote": "Trusted by collectors across Switzerland.", "author": "ARVI" } },
        { "type": "review", "settings": { "quote": "Professional advice and climate-controlled storage I can rely on.", "author": "Marco L." } },
        { "type": "review", "settings": { "quote": "The autumn selection was outstanding — rare finds delivered with care.", "author": "Elena R." } }
      ]
    }
  ]
}
{% endschema %}
