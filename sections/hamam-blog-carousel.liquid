<section
  id="hamam-blog-{{ section.id }}"
  class="hamam-section hamam-blog"
  data-section-id="{{ section.id }}"
>
  <div class="hamam-container--wide">
    <header class="hamam-section-head hamam-section-head--center">
      <h2 class="hamam-heading">{{ section.settings.heading }}</h2>
    </header>

    <div class="hamam-blog-slider hamam-slick" data-hamam-slick="blog">
      {% if section.settings.blog != blank %}
        {% for article in section.settings.blog.articles limit: section.settings.post_limit %}
          <article class="hamam-blog-card">
            <a class="hamam-blog-card__link" href="{{ article.url }}">
              <div class="hamam-blog-card__media">
                {% if article.image %}
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 1000px) 33vw, 100vw', alt: article.title
                  }}
                {% else %}
                  <div class="hamam-banner__placeholder" aria-hidden="true"></div>
                {% endif %}
              </div>
              <h3 class="hamam-blog-card__title">{{ article.title }}</h3>
              {% if article.excerpt_or_content != blank %}
                <p class="hamam-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              {% endif %}
              <span class="hamam-blog-card__read">{{ section.settings.read_more_label }}</span>
            </a>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <article class="hamam-blog-card">
            <div class="hamam-blog-card__media"><div class="hamam-banner__placeholder" aria-hidden="true"></div></div>
            <h3 class="hamam-blog-card__title">Blog post title</h3>
            <p class="hamam-blog-card__excerpt">Add a blog in section settings to display posts here.</p>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.blog != blank and section.settings.view_all_label != blank %}
      <div class="hamam-section-foot">
        <a class="hamam-btn" href="{{ section.settings.blog.url }}">{{ section.settings.view_all_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hamam — Blog carousel",
  "tag": "section",
  "class": "hamam-blog-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Read our blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Posts to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button",
      "default": "View all posts"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read more"
    }
  ],
  "presets": [
    {
      "name": "Hamam — Blog carousel"
    }
  ]
}
{% endschema %}
