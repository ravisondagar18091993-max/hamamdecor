<section
  id="hamam-split-{{ section.id }}"
  class="hamam-section hamam-story{% if section.settings.reverse_layout %} hamam-story--reverse{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="hamam-story__copy">
    <div class="hamam-story__inner">
      {% if section.settings.heading != blank %}
        <h2 class="hamam-display hamam-display--sm">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="hamam-story__rte rte">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="hamam-btn hamam-btn--accent" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
  <div class="hamam-story__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: section.settings.heading
      }}
    {% else %}
      <div class="hamam-ph hamam-ph--tall" aria-hidden="true"></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hamam — Story split",
  "tag": "section",
  "class": "hamam-split-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Image on left",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Handcrafted stone furniture for distinctive interiors"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Each piece is shaped from natural stone with care — balancing sculptural form with everyday function for halls, living spaces, and curated corners.</p><p>Explore consoles, tables, and objects designed to feel collected, not mass-produced.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "About us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hamam — Story split"
    }
  ]
}
{% endschema %}
