<section class="arvi-section arvi-duo" id="arvi-duo-{{ section.id }}">
  <div class="arvi-wrap">
    <div class="arvi-duo__grid">
      {% for block in section.blocks %}
        <div class="arvi-duo-card" {{ block.shopify_attributes }}>
          <div class="arvi-duo-card__icon" aria-hidden="true">{{ block.settings.icon | default: '◇' }}</div>
          {% if block.settings.title != blank %}
            <h3 class="arvi-duo-card__title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="arvi-duo-card__text">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.button_label != blank %}
            <a class="arvi-btn" href="{{ block.settings.link | default: '#' }}">{{ block.settings.button_label }}</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ARVI — Duo cards",
  "tag": "section",
  "class": "arvi-duo-section",
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon character", "default": "🎁" },
        { "type": "text", "id": "title", "label": "Title", "default": "Limited edition gifts" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Curated wooden cases and rare bottles for special occasions." },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ARVI — Duo cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "icon": "🎁",
            "title": "Limited edition gift selections",
            "text": "Exclusive wooden cases and rare bottles — perfect for gifting.",
            "button_label": "Shop now"
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "◆",
            "title": "Private clients & trade",
            "text": "Bespoke sourcing, wine vault storage, and personal delivery across Switzerland.",
            "button_label": "Find out more"
          }
        }
      ]
    }
  ]
}
{% endschema %}
