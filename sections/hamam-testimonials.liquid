<section class="hamam-reviews" id="hamam-reviews-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="hamam-container--wide">
    <header class="hamam-row-head hamam-row-head--center">
      <h2 class="hamam-display">{{ section.settings.heading }}</h2>
    </header>

    <div class="hamam-reviews__grid hamam-review-slider hamam-slick" data-hamam-slick="reviews">
      {% for block in section.blocks %}
        <article class="hamam-review-card" {{ block.shopify_attributes }}>
          <div class="hamam-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {% assign stars = block.settings.rating | default: 5 %}
            {% for i in (1..5) %}
              <span class="hamam-star{% if i > stars %} hamam-star--off{% endif %}">★</span>
            {% endfor %}
          </div>
          <blockquote class="hamam-review-card__quote">{{ block.settings.quote }}</blockquote>
          <p class="hamam-review-card__name">{{ block.settings.name }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hamam — Testimonials",
  "tag": "section",
  "class": "hamam-testimonials-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "\"Beautiful craftsmanship — the console is even more stunning in person.\""
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hamam — Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
