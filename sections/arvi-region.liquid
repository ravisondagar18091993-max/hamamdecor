<section class="arvi-section arvi-region" id="arvi-region-{{ section.id }}">
  <div class="arvi-region__copy">
    <div class="arvi-region__inner">
      {% if section.settings.eyebrow != blank %}
        <p class="arvi-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="arvi-region__title">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p class="arvi-split__body">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="arvi-btn arvi-btn--solid" href="{{ section.settings.button_link | default: routes.collections_url }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
  <div class="arvi-region__visual">
    {% if section.settings.bg_image != blank %}
      {{ section.settings.bg_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: '' }}
    {% endif %}
    {% if section.settings.bottle_image != blank %}
      {{ section.settings.bottle_image | image_url: width: 400 | image_tag: class: 'arvi-region__bottle', loading: 'lazy', alt: section.settings.heading }}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "ARVI — Region spotlight",
  "tag": "section",
  "class": "arvi-region-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Region in focus" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ticino & Lombardy" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Discover Unico, Rovere and Ligornetto — iconic labels from Italy and Switzerland, curated for discerning collectors."
    },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "image_picker", "id": "bg_image", "label": "Background (grape) image" },
    { "type": "image_picker", "id": "bottle_image", "label": "Bottle image" }
  ],
  "presets": [{ "name": "ARVI — Region spotlight" }]
}
{% endschema %}
