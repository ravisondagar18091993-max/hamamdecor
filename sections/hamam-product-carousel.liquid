<section
  id="hamam-products-{{ section.id }}"
  class="hamam-section hamam-products"
  data-section-id="{{ section.id }}"
>
  <div class="hamam-container--wide">
    <header class="hamam-section-head hamam-section-head--center">
      <h2 class="hamam-heading">{{ section.settings.heading }}</h2>
    </header>

    <div
      class="hamam-product-slider hamam-slick"
      data-hamam-slick="products"
      data-slide-count="{{ section.settings.products_to_show }}"
    >
      {% assign product_count = 0 %}
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% assign product_count = product_count | plus: 1 %}
          <div class="hamam-product-card">
            <a class="hamam-product-card__link" href="{{ product.url }}" aria-label="{{ product.title }}">
              <div class="hamam-product-card__media">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', widths: '400,600,800,900', sizes: '(min-width: 900px) 25vw, 50vw', alt: product.title
                  }}
                {% else %}
                  <div class="hamam-banner__placeholder" aria-hidden="true"></div>
                {% endif %}
              </div>
              <div class="hamam-product-card__info">
                <h3 class="hamam-product-card__title">{{ product.title }}</h3>
                <div class="hamam-product-card__price">
                  {% render 'price', product_resource: product, show_sale_price_first: true %}
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}

      {% if product_count == 0 %}
        {% for i in (1..4) %}
          <div class="hamam-product-card">
            <div class="hamam-product-card__media">
              <div class="hamam-banner__placeholder" aria-hidden="true"></div>
            </div>
            <div class="hamam-product-card__info">
              <h3 class="hamam-product-card__title">Sample product {{ i }}</h3>
              <div class="hamam-product-card__price">{% render 'price', product_resource: blank %}</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.collection != blank and section.settings.view_all_label != blank %}
      <div class="hamam-section-foot">
        <a class="hamam-btn" href="{{ section.settings.collection.url }}">{{ section.settings.view_all_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hamam — Product carousel",
  "tag": "section",
  "class": "hamam-product-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Hamam — Product carousel"
    }
  ]
}
{% endschema %}
