<section
  id="hamam-products-{{ section.id }}"
  class="hamam-section hamam-products hamam-products--luxury"
  data-section-id="{{ section.id }}"
>
  <div class="hamam-container--wide">
    <header class="hamam-row-head">
      <div class="hamam-row-head__intro">
        <h2 class="hamam-display">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="hamam-row-head__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      <a class="hamam-pill-btn" href="{{ section.settings.collection.url | default: '/collections/all' }}">
        <span class="hamam-pill-btn__mark" aria-hidden="true">›</span>
        <span>{{ section.settings.view_all_label }}</span>
      </a>
    </header>

    <div class="hamam-product-slider hamam-slick" data-hamam-slick="products">
      {% assign rendered = 0 %}
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: 4 %}
          {% assign rendered = rendered | plus: 1 %}
          {% assign fb = 'product-' | append: forloop.index %}
          <div class="hamam-product-card">
            <a class="hamam-product-card__link" href="{{ product.url }}" aria-label="{{ product.title }}">
              <div class="hamam-product-card__media">
                {% render 'hamam-img',
                  image: product.featured_image,
                  fallback: fb,
                  alt: product.title,
                  widths: '400,600,800',
                  sizes: '(min-width: 900px) 25vw, 50vw'
                %}
                {% render 'hamam-product-card-hover' %}
                {% if product.compare_at_price_max > product.price_min %}
                  <span class="hamam-product-card__badge">{{ section.settings.sale_label }}</span>
                {% endif %}
              </div>
              <h3 class="hamam-product-card__title">{{ product.title }}</h3>
              <div class="hamam-product-card__price">
                {% render 'price', product_resource: product, show_sale_price_first: true %}
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}

      {% assign pad_start = rendered | plus: 1 %}
      {% for i in (pad_start..4) %}
        {% render 'hamam-dummy-product', index: i %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hamam — Product carousel",
  "tag": "section",
  "class": "hamam-product-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link",
      "default": "View all"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale badge",
      "default": "Sale"
    }
  ],
  "presets": [
    {
      "name": "Hamam — Product carousel"
    }
  ]
}
{% endschema %}
