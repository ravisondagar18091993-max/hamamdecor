<section
  id="hamam-products-{{ section.id }}"
  class="hamam-section hamam-products hamam-section--cream"
  data-section-id="{{ section.id }}"
>
  <div class="hamam-container--wide">
    <div class="hamam-products__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="hamam-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="hamam-heading">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.collection != blank and section.settings.view_all_label != blank %}
        <a class="hamam-btn hamam-btn--ghost" href="{{ section.settings.collection.url }}">
          {{ section.settings.view_all_label }}
        </a>
      {% endif %}
    </div>

    <div
      class="hamam-product-slider hamam-slick"
      data-hamam-slick="products"
    >
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <div class="hamam-product-card">
            <a class="hamam-product-card__link" href="{{ product.url }}" aria-label="{{ product.title }}">
              <div class="hamam-product-card__media">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', widths: '400,600,800,900', sizes: '(min-width: 900px) 25vw, 50vw', alt: product.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
                {% if product.compare_at_price_max > product.price_min %}
                  <span class="hamam-product-card__badge">{{ section.settings.sale_label }}</span>
                {% endif %}
              </div>
              <div class="hamam-product-card__info">
                <h3 class="hamam-product-card__title">{{ product.title }}</h3>
                <div class="hamam-product-card__price">
                  {% render 'price', product_resource: product, show_sale_price_first: true %}
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <div class="hamam-product-card">
            <div class="hamam-product-card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
            <div class="hamam-product-card__info">
              <h3 class="hamam-product-card__title">Product title</h3>
              <div class="hamam-product-card__price">{% render 'price', product_resource: blank %}</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hamam — Product carousel",
  "tag": "section",
  "class": "hamam-product-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button",
      "default": "View all"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale badge text",
      "default": "Sale"
    }
  ],
  "presets": [
    {
      "name": "Hamam — Product carousel"
    }
  ]
}
{% endschema %}
