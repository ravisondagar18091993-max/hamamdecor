<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&display=swap"
  rel="stylesheet"
>

<section
  id="hamam-hero-{{ section.id }}"
  class="hamam-section hamam-hero hamam-hero-section"
  data-section-id="{{ section.id }}"
>
  <div
    class="hamam-hero-slider hamam-slick"
    data-hamam-slick="hero"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed }}"
  >
    {% for block in section.blocks %}
      <div class="hamam-hero__slide" {{ block.shopify_attributes }}>
        <div class="hamam-hero__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800,1200,1600,2000,2400', sizes: '100vw', alt: block.settings.heading
            }}
          {% else %}
            <div class="hamam-banner__placeholder hamam-banner__placeholder--hero" aria-hidden="true"></div>
          {% endif %}
        </div>
        <div class="hamam-hero__overlay"></div>
        <div class="hamam-hero__content">
          <div class="hamam-hero__content-inner">
            {% if block.settings.heading != blank %}
              <h2 class="hamam-hero__title">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.subheading != blank and section.settings.show_subheading %}
              <p class="hamam-hero__lead">{{ block.settings.subheading }}</p>
            {% endif %}
            {% if block.settings.button_label != blank and section.settings.show_button %}
              <div class="hamam-hero__actions">
                <a
                  class="hamam-btn hamam-btn--outline-light"
                  href="{{ block.settings.button_link | default: '#' }}"
                >
                  {{ block.settings.button_label }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  {% if section.settings.show_scroll_hint %}
    <span class="hamam-scroll-hint" aria-hidden="true"></span>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hamam — Hero slider",
  "tag": "section",
  "class": "hamam-hero-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay interval (ms)",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "default": 6000
    },
    {
      "type": "checkbox",
      "id": "show_subheading",
      "label": "Show subheading",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Bring the outside in"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hamam — Hero slider",
      "blocks": [
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
