<section class="hamam-editorial" id="hamam-editorial-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="hamam-container--wide">
    <header class="hamam-row-head hamam-row-head--editorial">
      <div class="hamam-row-head__intro">
        {% if section.settings.heading != blank %}
          <h2 class="hamam-display">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="hamam-row-head__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      {% if section.settings.view_all_label != blank %}
        <a class="hamam-pill-btn" href="{{ section.settings.blog.url | default: '/blogs/news' }}">
          <span class="hamam-pill-btn__mark" aria-hidden="true">›</span>
          <span>{{ section.settings.view_all_label }}</span>
        </a>
      {% endif %}
    </header>

    <div class="hamam-editorial__grid">
      {% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
        {% for article in section.settings.blog.articles limit: 3 %}
          {% assign fb = 'editorial-' | append: forloop.index %}
          <article class="hamam-editorial-card">
            <a class="hamam-editorial-card__link" href="{{ article.url }}">
              <div class="hamam-editorial-card__media">
                {% render 'hamam-img',
                  image: article.image,
                  fallback: fb,
                  alt: article.title,
                  widths: '400,600,800',
                  sizes: '(min-width: 1100px) 33vw, (min-width: 768px) 50vw, 100vw',
                  width: 1000
                %}
              </div>
              <h3 class="hamam-editorial-card__title">{{ article.title }}</h3>
              {% assign editorial_excerpt = article.excerpt_or_content | strip_html | strip %}
              {% if editorial_excerpt != blank %}
                <p class="hamam-editorial-card__excerpt">{{ editorial_excerpt }}</p>
              {% endif %}
            </a>
          </article>
        {% endfor %}
      {% else %}
        {% render 'hamam-editorial-dummy',
          index: 1,
          title: 'Stone in the modern home',
          description: 'How natural stone brings warmth and quiet luxury to contemporary interiors.'
        %}
        {% render 'hamam-editorial-dummy',
          index: 2,
          title: 'Caring for natural surfaces',
          description: 'Simple routines to protect marble, travertine, and limestone for years to come.'
        %}
        {% render 'hamam-editorial-dummy',
          index: 3,
          title: 'Designing with travertine',
          description: 'Texture, tone, and placement ideas for baths, kitchens, and living spaces.'
        %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hamam — Blog trio",
  "tag": "section",
  "class": "hamam-blog-duo-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "From the journal"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Stories on stone, craft, and living well at home."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Hamam — Blog trio"
    }
  ]
}
{% endschema %}
