<section
  class="hamam-section hamam-video-gallery"
  id="hamam-video-gallery-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="hamam-container--wide">
    <header class="hamam-video-gallery__head">
      <div class="hamam-row-head__intro">
        {% if section.settings.heading != blank %}
          <h2 class="hamam-display">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="hamam-row-head__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      {% if section.settings.button_label != blank %}
        <a class="hamam-pill-btn" href="{{ section.settings.button_link | default: '#' }}">
          <span class="hamam-pill-btn__mark" aria-hidden="true">›</span>
          <span>{{ section.settings.button_label }}</span>
        </a>
      {% endif %}
    </header>

    <div class="hamam-video-gallery__layout" data-hamam-video-gallery>
      <div class="hamam-video-gallery__player">
        {% for block in section.blocks %}
          <div
            class="hamam-video-gallery__panel{% if forloop.first %} is-active{% endif %}"
            data-hamam-video-panel="{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            {% if block.settings.video != blank %}
              {{
                block.settings.video
                | video_tag:
                  image_size: '1600x',
                  autoplay: forloop.first,
                  loop: true,
                  muted: true,
                  controls: true,
                  class: 'hamam-video-gallery__video'
              }}
            {% elsif block.settings.video_url != blank %}
              {% assign ext_id = block.settings.video_url.id %}
              {% assign ext_type = block.settings.video_url.type %}
              {% if ext_type == 'youtube' %}
                {% capture yt_base %}https://www.youtube.com/embed/{{ ext_id }}?rel=0&playsinline=1{% endcapture %}
                <iframe
                  class="hamam-video-gallery__iframe"
                  data-hamam-video-embed="{{ yt_base }}"
                  src="{{ yt_base }}{% if forloop.first %}&autoplay=1&mute=1{% endif %}"
                  title="{{ block.settings.title | escape }}"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              {% elsif ext_type == 'vimeo' %}
                {% capture vimeo_base %}https://player.vimeo.com/video/{{ ext_id }}?{% endcapture %}
                <iframe
                  class="hamam-video-gallery__iframe"
                  data-hamam-video-embed="{{ vimeo_base }}"
                  src="{{ vimeo_base }}{% if forloop.first %}autoplay=1&{% endif %}muted=1"
                  title="{{ block.settings.title | escape }}"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              {% endif %}
            {% else %}
              <div class="hamam-video-gallery__placeholder">
                {% assign fb = 'editorial-' | append: forloop.index %}
                {% render 'hamam-img',
                  image: block.settings.cover_image,
                  fallback: fb,
                  alt: block.settings.title,
                  widths: '800,1200,1600',
                  sizes: '(min-width: 900px) 58vw, 100vw'
                %}
                <span class="hamam-video-gallery__placeholder-label">{{ section.settings.placeholder_label }}</span>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="hamam-video-gallery__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {% for block in section.blocks %}
          {% assign fb = 'editorial-' | append: forloop.index %}
          <button
            type="button"
            class="hamam-video-gallery__thumb{% if forloop.first %} is-active{% endif %}"
            data-hamam-video-select="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="hamam-video-panel-{{ section.id }}-{{ forloop.index0 }}"
          >
            <span class="hamam-video-gallery__thumb-media">
              {% if block.settings.cover_image != blank %}
                {{
                  block.settings.cover_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '200,400,600', sizes: '200px', alt: ''
                }}
              {% elsif block.settings.video != blank and block.settings.video.preview_image != blank %}
                {{
                  block.settings.video.preview_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '200,400,600', sizes: '200px', alt: ''
                }}
              {% else %}
                {% render 'hamam-img',
                  image: blank,
                  fallback: fb,
                  alt: block.settings.title,
                  widths: '200,400,600',
                  sizes: '200px'
                %}
              {% endif %}
              <span class="hamam-video-gallery__thumb-play" aria-hidden="true"></span>
            </span>
            {% if block.settings.title != blank %}
              <span class="hamam-video-gallery__thumb-title">{{ block.settings.title }}</span>
            {% endif %}
          </button>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'hamam-video-gallery.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hamam — Video gallery",
  "tag": "section",
  "class": "hamam-video-gallery-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "See the craft"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Watch how natural stone is shaped into furniture for distinctive interiors."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label (no video)",
      "default": "Add a video in theme settings"
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Shopify-hosted video"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Or YouTube / Vimeo URL",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Thumbnail (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Studio film"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hamam — Video gallery",
      "blocks": [
        { "type": "video_item", "settings": { "title": "The atelier" } },
        { "type": "video_item", "settings": { "title": "Stone selection" } },
        { "type": "video_item", "settings": { "title": "Hand finishing" } },
        { "type": "video_item", "settings": { "title": "In your home" } }
      ]
    }
  ]
}
{% endschema %}
